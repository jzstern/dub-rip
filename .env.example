# =============================================================================
# bgutil-pot (Required for YouTube downloads)
# =============================================================================

# PO token sidecar that yt-dlp calls during extraction. Downloads fail fast
# without it. Run it locally with:
#   docker run --rm -d --init -p 4416:4416 brainicism/bgutil-ytdlp-pot-provider:1.3.1
BGUTIL_POT_URL=http://127.0.0.1:4416

# For Railway deployment (internal service-to-service):
# BGUTIL_POT_URL=http://bgutil-pot.railway.internal:4416

# =============================================================================
# Railway Runtime Configuration (only for Railway deployments)
# =============================================================================

# Required for yt-dlp - installs Python in the runtime container
# RAILPACK_DEPLOY_APT_PACKAGES=python3

# =============================================================================
# Sentry Error Monitoring (Optional)
# =============================================================================

# Leave both unset to disable Sentry entirely — the SDK no-ops without a DSN
# and the app runs normally, logging errors to the console only.
# Get your DSN from https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
# SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Used at build time only. Without it the build still succeeds, but no source
# maps are uploaded, so browser stack traces in Sentry stay minified.
# Create an organization auth token (not a personal one) at
# https://jzs-yw.sentry.io/settings/auth-tokens/ — it is shown once.
# SENTRY_AUTH_TOKEN=sntrys_...

# All environments share one DSN and one Sentry project; they are told apart by
# the `environment` tag. Resolution order:
#   1. SENTRY_ENVIRONMENT / PUBLIC_SENTRY_ENVIRONMENT (explicit, any string)
#   2. RAILWAY_ENVIRONMENT_NAME ("production" -> production, else -> preview)
#   3. neither -> "development"
# Railway sets its own variables, so nothing below is needed on Railway. Set
# these only to name an environment explicitly, e.g. in a local Doppler config:
# SENTRY_ENVIRONMENT=development
# PUBLIC_SENTRY_ENVIRONMENT=development

# Check what a running instance actually resolved: GET /api/health -> .sentry
